# AllSource Environment Configuration

# Core Event Store
ALLSOURCE_CORE_URL=http://localhost:8080
RUST_LOG=info

# Control Plane
ALLSOURCE_CONTROL_URL=http://localhost:8081
PORT=8081

# Web UI
NEXT_PUBLIC_CORE_API=http://localhost:8080
NEXT_PUBLIC_CONTROL_API=http://localhost:8081

# MCP Server
MCP_SERVER_PORT=3001

# =====================================
# x402 Payment Infrastructure (Hackathon)
# =====================================

# AllSource Event Store (deployed instance)
ALLSOURCE_URL=https://allsource-x402-demo.fly.dev

# Solana Configuration
SOLANA_WALLET=YOUR_SOLANA_WALLET_PUBLIC_KEY
SOLANA_RPC=https://api.devnet.solana.com

# OpenAI API (for demo AI endpoint)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Public URLs (for dashboard/frontend - must start with NEXT_PUBLIC_)
NEXT_PUBLIC_ALLSOURCE_URL=https://allsource-x402-demo.fly.dev
NEXT_PUBLIC_ALLSOURCE_WS=wss://allsource-x402-demo.fly.dev/api/v1/events/stream

# Optional: Mock mode for testing without Solana
MOCK_SOLANA=false

# LemonSqueezy production cutover (Taskfile ls-* tasks; docs/runbooks/PRICING_BILLING_CUTOVER.md)
# Your LIVE LemonSqueezy API key — used locally by `task ls-variant|ls-variants|ls-webhook-register`.
# Keep it in .env only (gitignored); it is also set as a Fly secret on allsource-control-plane.
LEMON_SQUEEZY_API_KEY=

# =====================================
# GEO measurement (tooling/geo — docs/runbooks/GEO_MEASUREMENT.md)
# =====================================
# The `geo` CLI reads this file through dotenvy, searching upward from the
# working directory. REAL PROCESS ENVIRONMENT VARIABLES ALWAYS WIN over it, so
# `ANTHROPIC_API_KEY=sk-... geo probe` overrides whatever is set here. A missing
# .env is fine — `geo probe --dry-run` needs no key at all.
# NEVER put a real key in this example file; it is committed.

# Control Plane gateway that GEO telemetry is written through. Required for any
# command that writes or reads events; not needed for --dry-run.
ALLSOURCE_API_KEY=
# Optional; defaults to https://api.all-source.xyz
ALLSOURCE_API_URL=

# Layer-3 probe engines. Each is optional: an engine with no key is SKIPPED with
# a loud warning and is never counted as zero share of voice.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Optional model overrides. Vendor model ids churn faster than this repo does —
# verify them against the vendor's current list before the first live sweep.
GEO_CHATGPT_MODEL=
GEO_CLAUDE_MODEL=
GEO_GEMINI_MODEL=
GEO_PERPLEXITY_MODEL=
# The LLM-as-judge model for layer 3b. Defaults to claude-opus-5.
GEO_JUDGE_MODEL=
