# AllSource Environment Configuration

# Core Event Store
ALLSOURCE_CORE_URL=http://localhost:8080
RUST_LOG=info

# Control Plane
ALLSOURCE_CONTROL_URL=http://localhost:8081
PORT=8081

# Web UI
NEXT_PUBLIC_CORE_API=http://localhost:8080
NEXT_PUBLIC_CONTROL_API=http://localhost:8081

# MCP Server
MCP_SERVER_PORT=3001

# =====================================
# x402 Payment Infrastructure (Hackathon)
# =====================================

# AllSource Event Store (deployed instance)
ALLSOURCE_URL=https://allsource-x402-demo.fly.dev

# Solana Configuration
SOLANA_WALLET=YOUR_SOLANA_WALLET_PUBLIC_KEY
SOLANA_RPC=https://api.devnet.solana.com

# OpenAI API (for demo AI endpoint)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Public URLs (for dashboard/frontend - must start with NEXT_PUBLIC_)
NEXT_PUBLIC_ALLSOURCE_URL=https://allsource-x402-demo.fly.dev
NEXT_PUBLIC_ALLSOURCE_WS=wss://allsource-x402-demo.fly.dev/api/v1/events/stream

# Optional: Mock mode for testing without Solana
MOCK_SOLANA=false
