{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://all-source.xyz/contracts/email-events/email.archived.schema.json",
  "title": "email.archived",
  "description": "A message archived. entity_id = provider message id (shared with email.received). Deletion is a tombstone event, not a mutation (§7).",
  "type": "object",
  "required": ["event_type", "entity_id", "tenant_id", "payload"],
  "additionalProperties": false,
  "properties": {
    "event_type": { "const": "email.archived" },
    "entity_id": { "type": "string", "minLength": 1, "description": "provider message id of the archived message" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "expected_version": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "required": ["by", "archived_at"],
      "additionalProperties": false,
      "properties": {
        "by": { "type": "string", "enum": ["claude", "human"] },
        "reason": { "type": "string" },
        "archived_at": { "type": "string", "format": "date-time" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
