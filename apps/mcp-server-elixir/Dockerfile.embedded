# syntax=docker/dockerfile:1.7
# =============================================================================
# AllSource MCP Server — EMBEDDED build (issue #129)
# =============================================================================
# This variant compiles the Rustler NIF (native/core_nif) so the server can
# run with CORE_MODE=embedded — an in-process AllSource store reading WAL +
# Parquet directly, with no separate Core container.
#
# The default `Dockerfile` builds CORE_MODE=remote and does NOT include the
# embedded modules (they are guarded by a compile-time `CORE_MODE` check).
# Use this file to publish the separate `:embedded` image tag.
#
# Build context is apps/mcp-server-elixir. core_nif depends on allsource-core
# from crates.io (not a path), so no other app's source is copied — the
# monorepo isolation rule still holds.
# =============================================================================

ARG ELIXIR_VERSION=1.18
ARG OTP_VERSION=27
ARG ALPINE_VERSION=3.23

# =============================================================================
# Stage 1: Build (Elixir + Rust toolchain)
# =============================================================================
FROM elixir:${ELIXIR_VERSION}-otp-${OTP_VERSION}-alpine AS builder

ARG VERSION=dev
ARG REVISION=unknown

# Elixir build deps + Rust toolchain for the Rustler NIF. clang/llvm + cmake
# are required by allsource-core's embedded dependency tree (rocksdb bindgen,
# simd-json); linux-headers/openssl-dev cover the rest of the native crates.
RUN apk add --no-cache \
    git build-base \
    cargo rust \
    clang llvm-dev \
    cmake linux-headers \
    openssl-dev perl

# Embedded mode is a compile-time decision — set it before `mix compile` so the
# CoreEmbedded / CoreNif modules and the NIF are built into the release.
ENV MIX_ENV=prod \
    CORE_MODE=embedded

WORKDIR /app

RUN mix local.hex --force && \
    mix local.rebar --force

# Copy config and mix files
COPY mix.exs mix.lock ./
COPY config config

RUN mix deps.get --only $MIX_ENV && \
    mix deps.compile

# Copy source + the Rustler NIF crate (native/core_nif builds standalone)
COPY lib lib
COPY native native

# Compile (builds the NIF via Rustler) and assemble the release
RUN mix compile && \
    mix release

# =============================================================================
# Stage 2: Runtime
# =============================================================================
FROM alpine:${ALPINE_VERSION}

ARG VERSION=dev
ARG REVISION=unknown
ARG BUILDTIME=unknown

LABEL org.opencontainers.image.title="AllSource MCP Server (embedded)" \
      org.opencontainers.image.description="MCP server with in-process embedded AllSource Core (CORE_MODE=embedded)" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${BUILDTIME}" \
      org.opencontainers.image.vendor="AllSource Team" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/all-source-os/all-source"

# libstdc++/libgcc also cover the Rust NIF's runtime needs.
RUN apk add --no-cache \
    libstdc++ \
    libgcc \
    ncurses-libs \
    openssl \
    tini && \
    rm -rf /var/cache/apk/* /tmp/* && \
    addgroup -g 1000 allsource && \
    adduser -u 1000 -G allsource -s /sbin/nologin -D allsource

WORKDIR /app

# Copy release from builder (the NIF .so is bundled under priv/native/)
COPY --from=builder --chown=allsource:allsource /app/_build/prod/rel/mcp_server_elixir ./

USER allsource:allsource

EXPOSE 4001

# CORE_MODE stays embedded at runtime; mount the AllSource data dir at /data.
ENV PHX_SERVER=true \
    MIX_ENV=prod \
    PORT=4001 \
    CORE_MODE=embedded \
    CORE_DATA_DIR=/data

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD bin/mcp_server_elixir rpc "System.otp_release()" || exit 1

ENTRYPOINT ["/sbin/tini", "-g", "--"]

CMD ["bin/mcp_server_elixir", "start"]
