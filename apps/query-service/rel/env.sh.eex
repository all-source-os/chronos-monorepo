#!/bin/sh

# Configure IPv6 for Fly.io internal networking
# .internal hostnames resolve to IPv6-only (fdaa::) addresses
ip=$(grep fly-local-6pn /etc/hosts | cut -f 1)
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE=query_service_ex@${ip:-127.0.0.1}
export ELIXIR_ERL_OPTIONS="-kernel inet_dist_use_interface {0,0,0,0,0,0,0,0} -proto_dist inet6_tcp"
