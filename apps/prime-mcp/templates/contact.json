{
  "entity_type": "contact",
  "description": "An external person the agent maintains a relationship with — distinct from internal teammates. Use for prospects, vendors, customers, network connections.",
  "properties": {
    "name": { "type": "string", "required": true, "description": "Full name" },
    "email": { "type": "string", "required": false, "description": "Primary email" },
    "phone": { "type": "string", "required": false, "description": "Phone number" },
    "company": { "type": "string", "required": false, "description": "Their employer or organization" },
    "relationship": { "type": "string", "required": false, "description": "How you know them (e.g. 'prospect', 'vendor', 'introduced by Alice')" },
    "domain": { "type": "string", "required": true, "description": "Knowledge domain (e.g. 'sales', 'recruiting')" },
    "last_contact_at": { "type": "string", "required": false, "description": "ISO 8601 date of last interaction" },
    "notes": { "type": "string", "required": false, "description": "Free-form notes" }
  },
  "suggested_relations": [
    { "relation": "works_at", "direction": "outgoing", "target_type": "organization" },
    { "relation": "introduced_by", "direction": "outgoing", "target_type": "person" },
    { "relation": "interested_in", "direction": "outgoing", "target_type": "project" }
  ]
}
