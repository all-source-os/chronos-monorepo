{
  "entity_type": "task",
  "description": "A unit of work with a definite outcome. Use for to-dos, tickets, follow-ups, or anything that needs tracking until done.",
  "properties": {
    "title": { "type": "string", "required": true, "description": "Short summary of what needs to happen" },
    "status": { "type": "string", "required": true, "description": "One of: 'open', 'in_progress', 'blocked', 'done', 'cancelled'" },
    "priority": { "type": "string", "required": false, "description": "One of: 'p0', 'p1', 'p2', 'p3'" },
    "due_at": { "type": "string", "required": false, "description": "ISO 8601 timestamp of when this is due" },
    "assignee": { "type": "string", "required": false, "description": "Name or entity_id of the person responsible" },
    "domain": { "type": "string", "required": true, "description": "Knowledge domain (e.g. 'engineering', 'marketing')" },
    "notes": { "type": "string", "required": false, "description": "Context, links, acceptance criteria" }
  },
  "suggested_relations": [
    { "relation": "assigned_to", "direction": "outgoing", "target_type": "person" },
    { "relation": "blocks", "direction": "outgoing", "target_type": "task" },
    { "relation": "blocked_by", "direction": "outgoing", "target_type": "task" },
    { "relation": "part_of", "direction": "outgoing", "target_type": "project" }
  ]
}
