"use client";

import { useState } from "react";
import { Button, Card, CardHeader, CardTitle, CardContent, Badge } from "@allsource/ui";
import { eventStoreClient } from "@/lib/event-store/client";
import {
  generateEcommerceEvents,
  generateIoTEvents,
  generateUserActivityEvents,
  sampleSchemas,
} from "@/lib/event-store/demo-data";
import type { Event, Projection, Schema, Metrics } from "@/lib/event-store/types";

export default function EventStoreDemoPage() {
  const [activeSection, setActiveSection] = useState<string>("overview");
  const [isLoading, setIsLoading] = useState(false);
  const [events, setEvents] = useState<Event[]>([]);
  const [projections, setProjections] = useState<Projection[]>([]);
  const [schemas, setSchemas] = useState<Schema[]>([]);
  const [metrics, setMetrics] = useState<Metrics | null>(null);
  const [message, setMessage] = useState<{ type: "success" | "error"; text: string } | null>(null);

  const showMessage = (type: "success" | "error", text: string) => {
    setMessage({ type, text });
    setTimeout(() => setMessage(null), 5000);
  };

  // Demo Actions
  const handleGenerateEcommerceEvents = async () => {
    setIsLoading(true);
    try {
      const demoEvents = generateEcommerceEvents(20);
      const created = await eventStoreClient.createEventBatch(demoEvents);
      setEvents(created);
      showMessage("success", `Created ${created.length} e-commerce events`);
    } catch (error) {
      showMessage("error", `Failed to create events: ${error}`);
    } finally {
      setIsLoading(false);
    }
  };

  const handleGenerateIoTEvents = async () => {
    setIsLoading(true);
    try {
      const demoEvents = generateIoTEvents(30);
      const created = await eventStoreClient.createEventBatch(demoEvents);
      setEvents(created);
      showMessage("success", `Created ${created.length} IoT sensor events`);
    } catch (error) {
      showMessage("error", `Failed to create events: ${error}`);
    } finally {
      setIsLoading(false);
    }
  };

  const handleQueryEvents = async (entityId?: string, eventType?: string) => {
    setIsLoading(true);
    try {
      const results = await eventStoreClient.queryEvents({
        entity_id: entityId,
        event_type: eventType,
      });
      setEvents(results);
      showMessage("success", `Found ${results.length} events`);
    } catch (error) {
      showMessage("error", `Failed to query events: ${error}`);
    } finally {
      setIsLoading(false);
    }
  };

  const handleListProjections = async () => {
    setIsLoading(true);
    try {
      const results = await eventStoreClient.listProjections();
      setProjections(results);
      showMessage("success", `Found ${results.length} projections`);
    } catch (error) {
      showMessage("error", `Failed to list projections: ${error}`);
    } finally {
      setIsLoading(false);
    }
  };

  const handleCreateProjection = async () => {
    setIsLoading(true);
    try {
      const projection = await eventStoreClient.createProjection({
        name: "Order Counter",
        projection_type: "EventCounter",
        status: "Created",
        config: {
          batch_size: 100,
          checkpoint_interval: 1000,
          filters: { event_type: "OrderPlaced" },
        },
      });
      showMessage("success", `Created projection: ${projection.name}`);
      await handleListProjections();
    } catch (error) {
      showMessage("error", `Failed to create projection: ${error}`);
    } finally {
      setIsLoading(false);
    }
  };

  const handleRegisterSchemas = async () => {
    setIsLoading(true);
    try {
      const registered = [];
      for (const schema of sampleSchemas) {
        const result = await eventStoreClient.registerSchema(schema);
        registered.push(result);
      }
      setSchemas(registered);
      showMessage("success", `Registered ${registered.length} schemas`);
    } catch (error) {
      showMessage("error", `Failed to register schemas: ${error}`);
    } finally {
      setIsLoading(false);
    }
  };

  const handleGetMetrics = async () => {
    setIsLoading(true);
    try {
      const results = await eventStoreClient.getMetrics();
      setMetrics(results);
      showMessage("success", "Retrieved current metrics");
    } catch (error) {
      showMessage("error", `Failed to get metrics: ${error}`);
    } finally {
      setIsLoading(false);
    }
  };

  const sections = [
    { id: "overview", label: "Overview" },
    { id: "events", label: "Event Management" },
    { id: "queries", label: "Queries & Streaming" },
    { id: "projections", label: "Projections" },
    { id: "schemas", label: "Schema Management" },
    { id: "analytics", label: "Analytics" },
    { id: "security", label: "Security & Multi-tenancy" },
    { id: "monitoring", label: "Monitoring" },
  ];

  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-950 dark:to-slate-900">
      <div className="container mx-auto px-4 py-8">
        {/* Header */}
        <div className="mb-8">
          <h1 className="text-4xl font-bold mb-2 bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
            AllSource Event Store
          </h1>
          <p className="text-xl text-slate-600 dark:text-slate-400">
            Interactive Demo - Explore All Features
          </p>
        </div>

        {/* Message Banner */}
        {message && (
          <div
            className={`mb-6 p-4 rounded-lg ${
              message.type === "success"
                ? "bg-green-100 text-green-800 border border-green-200"
                : "bg-red-100 text-red-800 border border-red-200"
            }`}
          >
            {message.text}
          </div>
        )}

        {/* Navigation */}
        <div className="mb-8 flex flex-wrap gap-2">
          {sections.map((section) => (
            <Button
              key={section.id}
              variant={activeSection === section.id ? "default" : "outline"}
              onClick={() => setActiveSection(section.id)}
            >
              {section.label}
            </Button>
          ))}
        </div>

        {/* Overview Section */}
        {activeSection === "overview" && (
          <div className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle>Welcome to AllSource Event Store Demo</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <p className="text-slate-700 dark:text-slate-300">
                  AllSource is a high-performance, cloud-native event store designed for temporal
                  data intelligence. This interactive demo showcases all major features including:
                </p>

                <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
                  <Card className="bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-950 dark:to-blue-900">
                    <CardContent className="pt-6">
                      <h3 className="font-semibold text-lg mb-2">Event Management</h3>
                      <p className="text-sm text-slate-600 dark:text-slate-400">
                        Single & batch ingestion, full CRUD operations, immutable event log
                      </p>
                    </CardContent>
                  </Card>

                  <Card className="bg-gradient-to-br from-purple-50 to-purple-100 dark:from-purple-950 dark:to-purple-900">
                    <CardContent className="pt-6">
                      <h3 className="font-semibold text-lg mb-2">Powerful Queries</h3>
                      <p className="text-sm text-slate-600 dark:text-slate-400">
                        Query by entity, type, time range, as-of time, real-time streaming
                      </p>
                    </CardContent>
                  </Card>

                  <Card className="bg-gradient-to-br from-green-50 to-green-100 dark:from-green-950 dark:to-green-900">
                    <CardContent className="pt-6">
                      <h3 className="font-semibold text-lg mb-2">Projections</h3>
                      <p className="text-sm text-slate-600 dark:text-slate-400">
                        5 projection types, automatic rebuilding, state management
                      </p>
                    </CardContent>
                  </Card>

                  <Card className="bg-gradient-to-br from-orange-50 to-orange-100 dark:from-orange-950 dark:to-orange-900">
                    <CardContent className="pt-6">
                      <h3 className="font-semibold text-lg mb-2">Schema Evolution</h3>
                      <p className="text-sm text-slate-600 dark:text-slate-400">
                        JSON Schema validation, versioning, compatibility modes
                      </p>
                    </CardContent>
                  </Card>

                  <Card className="bg-gradient-to-br from-pink-50 to-pink-100 dark:from-pink-950 dark:to-pink-900">
                    <CardContent className="pt-6">
                      <h3 className="font-semibold text-lg mb-2">Analytics</h3>
                      <p className="text-sm text-slate-600 dark:text-slate-400">
                        Frequency analysis, correlations, time-series statistics
                      </p>
                    </CardContent>
                  </Card>

                  <Card className="bg-gradient-to-br from-cyan-50 to-cyan-100 dark:from-cyan-950 dark:to-cyan-900">
                    <CardContent className="pt-6">
                      <h3 className="font-semibold text-lg mb-2">Enterprise Security</h3>
                      <p className="text-sm text-slate-600 dark:text-slate-400">
                        Multi-tenancy, RBAC, JWT auth, rate limiting, encryption
                      </p>
                    </CardContent>
                  </Card>
                </div>

                <div className="mt-6 p-4 bg-blue-50 dark:bg-blue-950 rounded-lg border border-blue-200 dark:border-blue-800">
                  <h4 className="font-semibold mb-2">Performance Highlights</h4>
                  <div className="grid md:grid-cols-4 gap-4 text-center">
                    <div>
                      <div className="text-2xl font-bold text-blue-600">469K</div>
                      <div className="text-sm text-slate-600 dark:text-slate-400">Events/sec</div>
                    </div>
                    <div>
                      <div className="text-2xl font-bold text-blue-600">&lt;100ms</div>
                      <div className="text-sm text-slate-600 dark:text-slate-400">
                        Query Latency
                      </div>
                    </div>
                    <div>
                      <div className="text-2xl font-bold text-blue-600">60-80%</div>
                      <div className="text-sm text-slate-600 dark:text-slate-400">Compression</div>
                    </div>
                    <div>
                      <div className="text-2xl font-bold text-blue-600">1000s</div>
                      <div className="text-sm text-slate-600 dark:text-slate-400">
                        WebSocket Conns
                      </div>
                    </div>
                  </div>
                </div>
              </CardContent>
            </Card>
          </div>
        )}

        {/* Event Management Section */}
        {activeSection === "events" && (
          <div className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle>Event Management Demo</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <p className="text-slate-700 dark:text-slate-300">
                  Create and manage events with single or batch operations. Events are immutable and
                  stored with full metadata.
                </p>

                <div className="flex gap-3 flex-wrap">
                  <Button
                    onClick={handleGenerateEcommerceEvents}
                    disabled={isLoading}
                    variant="default"
                  >
                    Generate E-commerce Events
                  </Button>
                  <Button
                    onClick={handleGenerateIoTEvents}
                    disabled={isLoading}
                    variant="secondary"
                  >
                    Generate IoT Events
                  </Button>
                  <Button
                    onClick={() => handleQueryEvents(undefined, "OrderPlaced")}
                    disabled={isLoading}
                    variant="outline"
                  >
                    Query OrderPlaced Events
                  </Button>
                </div>

                {events.length > 0 && (
                  <div className="mt-6">
                    <h3 className="font-semibold mb-3">Recent Events ({events.length})</h3>
                    <div className="space-y-2 max-h-96 overflow-y-auto">
                      {events.slice(0, 10).map((event) => (
                        <Card key={event.id} className="bg-slate-50 dark:bg-slate-900">
                          <CardContent className="pt-4">
                            <div className="flex justify-between items-start mb-2">
                              <Badge variant="secondary">{event.event_type}</Badge>
                              <span className="text-xs text-slate-500">
                                {new Date(event.timestamp).toLocaleString()}
                              </span>
                            </div>
                            <div className="text-sm space-y-1">
                              <div>
                                <span className="font-medium">Entity:</span> {event.entity_id}
                              </div>
                              <div>
                                <span className="font-medium">Version:</span> {event.version}
                              </div>
                              <details className="mt-2">
                                <summary className="cursor-pointer text-blue-600 hover:text-blue-700">
                                  View Payload
                                </summary>
                                <pre className="mt-2 p-2 bg-slate-100 dark:bg-slate-800 rounded text-xs overflow-x-auto">
                                  {JSON.stringify(event.payload, null, 2)}
                                </pre>
                              </details>
                            </div>
                          </CardContent>
                        </Card>
                      ))}
                    </div>
                  </div>
                )}
              </CardContent>
            </Card>
          </div>
        )}

        {/* Queries & Streaming Section */}
        {activeSection === "queries" && (
          <div className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle>Queries & Real-time Streaming</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <p className="text-slate-700 dark:text-slate-300">
                  Query events by entity ID, event type, time range, or use as-of queries for
                  time-travel. Subscribe to real-time event streams via WebSocket.
                </p>

                <div className="grid md:grid-cols-2 gap-4">
                  <Card className="bg-blue-50 dark:bg-blue-950">
                    <CardContent className="pt-4">
                      <h4 className="font-semibold mb-2">Query Types</h4>
                      <ul className="space-y-1 text-sm">
                        <li>✓ By Entity ID - Get aggregate history</li>
                        <li>✓ By Event Type - Filter by type</li>
                        <li>✓ Time Range - Query time window</li>
                        <li>✓ As-Of Time - Time-travel queries</li>
                        <li>✓ Combined Filters - Multiple criteria</li>
                      </ul>
                    </CardContent>
                  </Card>

                  <Card className="bg-purple-50 dark:bg-purple-950">
                    <CardContent className="pt-4">
                      <h4 className="font-semibold mb-2">Real-time Streaming</h4>
                      <ul className="space-y-1 text-sm">
                        <li>✓ WebSocket connections</li>
                        <li>✓ Live event subscription</li>
                        <li>✓ Filter streaming events</li>
                        <li>✓ Thousands of concurrent connections</li>
                        <li>✓ Low-latency updates</li>
                      </ul>
                    </CardContent>
                  </Card>
                </div>

                <div className="mt-4 p-4 bg-slate-100 dark:bg-slate-900 rounded-lg">
                  <h4 className="font-semibold mb-3">Example Query API</h4>
                  <pre className="text-xs overflow-x-auto">
                    {`// Query by entity
const events = await client.queryEvents({
  entity_id: "order-123",
  limit: 100
});

// Query by type with time range
const events = await client.queryEvents({
  event_type: "OrderPlaced",
  from_timestamp: "2025-01-01T00:00:00Z",
  to_timestamp: "2025-01-31T23:59:59Z"
});

// Time-travel query (as-of)
const events = await client.queryEvents({
  entity_id: "order-123",
  as_of: "2025-01-15T12:00:00Z"
});

// Real-time streaming
const ws = client.createEventStream({ event_type: "OrderPlaced" });
ws.onmessage = (event) => console.log(JSON.parse(event.data));`}
                  </pre>
                </div>
              </CardContent>
            </Card>
          </div>
        )}

        {/* Projections Section */}
        {activeSection === "projections" && (
          <div className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle>Projections & Materialized Views</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <p className="text-slate-700 dark:text-slate-300">
                  Projections are materialized views that process event streams to create derived
                  state. Supports 5 types with automatic rebuilding.
                </p>

                <div className="flex gap-3 flex-wrap">
                  <Button onClick={handleListProjections} disabled={isLoading} variant="default">
                    List Projections
                  </Button>
                  <Button onClick={handleCreateProjection} disabled={isLoading} variant="secondary">
                    Create Sample Projection
                  </Button>
                </div>

                <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-4 mt-4">
                  <Card className="bg-green-50 dark:bg-green-950">
                    <CardContent className="pt-4">
                      <Badge className="mb-2">EntitySnapshot</Badge>
                      <p className="text-sm">Current state of entities</p>
                    </CardContent>
                  </Card>

                  <Card className="bg-blue-50 dark:bg-blue-950">
                    <CardContent className="pt-4">
                      <Badge className="mb-2">EventCounter</Badge>
                      <p className="text-sm">Count events by type</p>
                    </CardContent>
                  </Card>

                  <Card className="bg-purple-50 dark:bg-purple-950">
                    <CardContent className="pt-4">
                      <Badge className="mb-2">TimeSeries</Badge>
                      <p className="text-sm">Time-bucketed aggregations</p>
                    </CardContent>
                  </Card>

                  <Card className="bg-orange-50 dark:bg-orange-950">
                    <CardContent className="pt-4">
                      <Badge className="mb-2">Funnel</Badge>
                      <p className="text-sm">Conversion funnels</p>
                    </CardContent>
                  </Card>

                  <Card className="bg-pink-50 dark:bg-pink-950">
                    <CardContent className="pt-4">
                      <Badge className="mb-2">Custom</Badge>
                      <p className="text-sm">User-defined logic</p>
                    </CardContent>
                  </Card>
                </div>

                {projections.length > 0 && (
                  <div className="mt-6">
                    <h3 className="font-semibold mb-3">
                      Active Projections ({projections.length})
                    </h3>
                    <div className="space-y-2">
                      {projections.map((proj) => (
                        <Card key={proj.id} className="bg-slate-50 dark:bg-slate-900">
                          <CardContent className="pt-4">
                            <div className="flex justify-between items-start">
                              <div>
                                <h4 className="font-semibold">{proj.name}</h4>
                                <p className="text-sm text-slate-600 dark:text-slate-400">
                                  Type: {proj.projection_type}
                                </p>
                              </div>
                              <Badge variant={proj.status === "Running" ? "default" : "secondary"}>
                                {proj.status}
                              </Badge>
                            </div>
                            {proj.stats && (
                              <div className="mt-2 text-sm text-slate-600 dark:text-slate-400">
                                Events processed: {proj.stats.events_processed}
                              </div>
                            )}
                          </CardContent>
                        </Card>
                      ))}
                    </div>
                  </div>
                )}
              </CardContent>
            </Card>
          </div>
        )}

        {/* Schema Management Section */}
        {activeSection === "schemas" && (
          <div className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle>Schema Management & Evolution</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <p className="text-slate-700 dark:text-slate-300">
                  Register JSON Schemas for event validation with version control and compatibility
                  modes.
                </p>

                <div className="flex gap-3">
                  <Button onClick={handleRegisterSchemas} disabled={isLoading} variant="default">
                    Register Sample Schemas
                  </Button>
                </div>

                <div className="grid md:grid-cols-2 gap-4 mt-4">
                  <Card className="bg-blue-50 dark:bg-blue-950">
                    <CardContent className="pt-4">
                      <h4 className="font-semibold mb-2">Compatibility Modes</h4>
                      <ul className="space-y-1 text-sm">
                        <li>✓ None - No compatibility checks</li>
                        <li>✓ Backward - New schema can read old data</li>
                        <li>✓ Forward - Old schema can read new data</li>
                        <li>✓ Full - Both backward and forward</li>
                      </ul>
                    </CardContent>
                  </Card>

                  <Card className="bg-green-50 dark:bg-green-950">
                    <CardContent className="pt-4">
                      <h4 className="font-semibold mb-2">Features</h4>
                      <ul className="space-y-1 text-sm">
                        <li>✓ JSON Schema v7 support</li>
                        <li>✓ Automatic versioning</li>
                        <li>✓ Event validation on write</li>
                        <li>✓ Schema evolution tracking</li>
                      </ul>
                    </CardContent>
                  </Card>
                </div>

                {schemas.length > 0 && (
                  <div className="mt-6">
                    <h3 className="font-semibold mb-3">Registered Schemas ({schemas.length})</h3>
                    <div className="space-y-2">
                      {schemas.map((schema) => (
                        <Card key={schema.id} className="bg-slate-50 dark:bg-slate-900">
                          <CardContent className="pt-4">
                            <div className="flex justify-between items-start mb-2">
                              <div>
                                <h4 className="font-semibold">{schema.event_type}</h4>
                                <p className="text-sm text-slate-600 dark:text-slate-400">
                                  Version {schema.version}
                                </p>
                              </div>
                              <Badge>{schema.compatibility_mode}</Badge>
                            </div>
                            <details>
                              <summary className="cursor-pointer text-blue-600 hover:text-blue-700 text-sm">
                                View Schema
                              </summary>
                              <pre className="mt-2 p-2 bg-slate-100 dark:bg-slate-800 rounded text-xs overflow-x-auto">
                                {JSON.stringify(schema.schema, null, 2)}
                              </pre>
                            </details>
                          </CardContent>
                        </Card>
                      ))}
                    </div>
                  </div>
                )}
              </CardContent>
            </Card>
          </div>
        )}

        {/* Analytics Section */}
        {activeSection === "analytics" && (
          <div className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle>Advanced Analytics</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <p className="text-slate-700 dark:text-slate-300">
                  Run sophisticated analytics queries on event streams including frequency analysis,
                  correlations, and statistical summaries.
                </p>

                <div className="grid md:grid-cols-3 gap-4">
                  <Card className="bg-blue-50 dark:bg-blue-950">
                    <CardContent className="pt-4">
                      <h4 className="font-semibold mb-2">Frequency Analysis</h4>
                      <p className="text-sm">
                        Event counts by time buckets (minute/hour/day/week/month)
                      </p>
                    </CardContent>
                  </Card>

                  <Card className="bg-purple-50 dark:bg-purple-950">
                    <CardContent className="pt-4">
                      <h4 className="font-semibold mb-2">Correlation Detection</h4>
                      <p className="text-sm">Find patterns and relationships between event types</p>
                    </CardContent>
                  </Card>

                  <Card className="bg-green-50 dark:bg-green-950">
                    <CardContent className="pt-4">
                      <h4 className="font-semibold mb-2">Statistical Summary</h4>
                      <p className="text-sm">Min, max, avg, percentiles for numeric fields</p>
                    </CardContent>
                  </Card>
                </div>

                <div className="mt-4 p-4 bg-slate-100 dark:bg-slate-900 rounded-lg">
                  <h4 className="font-semibold mb-3">Example Analytics Query</h4>
                  <pre className="text-xs overflow-x-auto">
                    {`// Frequency analysis
const result = await client.runAnalytics({
  metric: "frequency",
  event_type: "OrderPlaced",
  time_range: {
    from: "2025-01-01T00:00:00Z",
    to: "2025-01-31T23:59:59Z"
  },
  granularity: "day"
});

// Correlation analysis
const correlations = await client.runAnalytics({
  metric: "correlation",
  time_range: {
    from: "2025-01-01T00:00:00Z",
    to: "2025-01-31T23:59:59Z"
  }
});`}
                  </pre>
                </div>
              </CardContent>
            </Card>
          </div>
        )}

        {/* Security & Multi-tenancy Section */}
        {activeSection === "security" && (
          <div className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle>Security & Multi-tenancy</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <p className="text-slate-700 dark:text-slate-300">
                  Enterprise-grade security with multi-tenancy, RBAC, JWT authentication, rate
                  limiting, and encryption.
                </p>

                <div className="grid md:grid-cols-2 gap-4">
                  <Card className="bg-red-50 dark:bg-red-950">
                    <CardContent className="pt-4">
                      <h4 className="font-semibold mb-2">Authentication & Authorization</h4>
                      <ul className="space-y-1 text-sm">
                        <li>✓ JWT-based authentication</li>
                        <li>✓ API key management</li>
                        <li>✓ RBAC with 4 roles</li>
                        <li>✓ 7 granular permissions</li>
                        <li>✓ Tenant isolation</li>
                      </ul>
                    </CardContent>
                  </Card>

                  <Card className="bg-orange-50 dark:bg-orange-950">
                    <CardContent className="pt-4">
                      <h4 className="font-semibold mb-2">Tenant Tiers</h4>
                      <ul className="space-y-1 text-sm">
                        <li>✓ Free - Limited quotas</li>
                        <li>✓ Standard - Medium quotas</li>
                        <li>✓ Professional - High quotas</li>
                        <li>✓ Enterprise - Custom quotas</li>
                      </ul>
                    </CardContent>
                  </Card>

                  <Card className="bg-purple-50 dark:bg-purple-950">
                    <CardContent className="pt-4">
                      <h4 className="font-semibold mb-2">Security Features</h4>
                      <ul className="space-y-1 text-sm">
                        <li>✓ Encryption at rest</li>
                        <li>✓ Encryption in transit (TLS)</li>
                        <li>✓ Key Management System (KMS)</li>
                        <li>✓ Audit logging</li>
                        <li>✓ Anomaly detection</li>
                      </ul>
                    </CardContent>
                  </Card>

                  <Card className="bg-blue-50 dark:bg-blue-950">
                    <CardContent className="pt-4">
                      <h4 className="font-semibold mb-2">Rate Limiting</h4>
                      <ul className="space-y-1 text-sm">
                        <li>✓ Adaptive rate limiting</li>
                        <li>✓ Per-tenant quotas</li>
                        <li>✓ Query throttling</li>
                        <li>✓ Burst allowances</li>
                      </ul>
                    </CardContent>
                  </Card>
                </div>
              </CardContent>
            </Card>
          </div>
        )}

        {/* Monitoring Section */}
        {activeSection === "monitoring" && (
          <div className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle>Monitoring & Metrics</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <p className="text-slate-700 dark:text-slate-300">
                  Comprehensive monitoring with Prometheus metrics, health checks, and performance
                  tracking.
                </p>

                <Button onClick={handleGetMetrics} disabled={isLoading} variant="default">
                  Get Current Metrics
                </Button>

                {metrics && (
                  <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-4 mt-4">
                    <Card className="bg-green-50 dark:bg-green-950">
                      <CardContent className="pt-4">
                        <div className="text-2xl font-bold text-green-600">
                          {metrics.ingestion_rate.toLocaleString()}
                        </div>
                        <div className="text-sm text-slate-600 dark:text-slate-400">Events/sec</div>
                      </CardContent>
                    </Card>

                    <Card className="bg-blue-50 dark:bg-blue-950">
                      <CardContent className="pt-4">
                        <div className="text-2xl font-bold text-blue-600">
                          {metrics.query_latency_ms}ms
                        </div>
                        <div className="text-sm text-slate-600 dark:text-slate-400">
                          Query Latency
                        </div>
                      </CardContent>
                    </Card>

                    <Card className="bg-purple-50 dark:bg-purple-950">
                      <CardContent className="pt-4">
                        <div className="text-2xl font-bold text-purple-600">
                          {metrics.active_connections}
                        </div>
                        <div className="text-sm text-slate-600 dark:text-slate-400">
                          Active Connections
                        </div>
                      </CardContent>
                    </Card>

                    <Card className="bg-orange-50 dark:bg-orange-950">
                      <CardContent className="pt-4">
                        <div className="text-2xl font-bold text-orange-600">
                          {metrics.storage_used_gb.toFixed(2)} GB
                        </div>
                        <div className="text-sm text-slate-600 dark:text-slate-400">
                          Storage Used
                        </div>
                      </CardContent>
                    </Card>

                    <Card className="bg-pink-50 dark:bg-pink-950">
                      <CardContent className="pt-4">
                        <div className="text-2xl font-bold text-pink-600">
                          {metrics.events_total.toLocaleString()}
                        </div>
                        <div className="text-sm text-slate-600 dark:text-slate-400">
                          Total Events
                        </div>
                      </CardContent>
                    </Card>
                  </div>
                )}

                <div className="grid md:grid-cols-2 gap-4 mt-6">
                  <Card className="bg-slate-50 dark:bg-slate-900">
                    <CardContent className="pt-4">
                      <h4 className="font-semibold mb-2">Available Metrics (18+)</h4>
                      <ul className="space-y-1 text-sm">
                        <li>✓ Ingestion rate & latency</li>
                        <li>✓ Query performance</li>
                        <li>✓ Projection stats</li>
                        <li>✓ Storage usage</li>
                        <li>✓ Connection counts</li>
                        <li>✓ Error rates</li>
                      </ul>
                    </CardContent>
                  </Card>

                  <Card className="bg-slate-50 dark:bg-slate-900">
                    <CardContent className="pt-4">
                      <h4 className="font-semibold mb-2">Health Endpoints</h4>
                      <ul className="space-y-1 text-sm">
                        <li>✓ GET /health - Core service health</li>
                        <li>✓ Control plane health</li>
                        <li>✓ Cluster status</li>
                        <li>✓ Component health checks</li>
                      </ul>
                    </CardContent>
                  </Card>
                </div>
              </CardContent>
            </Card>
          </div>
        )}
      </div>
    </div>
  );
}
