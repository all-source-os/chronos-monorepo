{
  "name": "@allsource/ui",
  "version": "0.1.0",
  "private": true,
  "description": "AllSource UI component library",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.tsx",
    "./styles": "./src/styles/globals.css"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "test": "bun test --preload ./src/__tests__/setup.ts",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.417.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@allsource/typescript-config": "workspace:*",
    "@biomejs/biome": "^1.9.4",
    "@happy-dom/global-registrator": "^15.11.7",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/bun": "^1.1.13",
    "@types/node": "^20.19.4",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "happy-dom": "^15.11.7",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
